# Copy to .env and fill in. .env is gitignored and must never be committed.

# Meta Marketing API token. Use a SYSTEM USER token scoped to the single
# account you intend to govern — a personal user token expires on a 60-day
# clock and will strand an unattended pipeline.
# Scopes: ads_management, ads_read, pages_read_engagement
META_ACCESS_TOKEN=

# Optional. Defaults to v23.0.
META_GRAPH_VERSION=v23.0

# The kill switch. Set to 1 to force propose-only regardless of any CLI flag
# or config value. Checked inside the dispatch function, so no code path
# routes around it. Leave this set until you have read a week of plans.
MOOT_READ_ONLY=1
